#!name=腾讯视频去广告
#!desc=去除腾讯视频开屏广告、视频播放前广告、底部多余栏、我的页面顶部广告等。原插件为 ZenmoFeiShi 的圈X重写《腾讯视频净化》（2026-11-03 更新），本文件是给 Loon 用的转换版，并补上了腾讯视频官方图标。
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/63/52/f9/6352f938-0945-2fd6-be70-6c5d07a8c780/AppIcon-0-0-1x_U007epad-0-1-0-0-sRGB-85-220.png/512x512bb.jpg
#!author=ZenmoFeiShi
#!homepage=https://github.com/ZenmoFeiShi/Qx
#!date=2026-11-15
#!category=ZenmoFeiShi

# ============================================================
# 腾讯视频去广告（Loon 插件）— 带图标版
# ------------------------------------------------------------
# 来源：ZenmoFeiShi/Qx 仓库的 TxvideoAD.snippet（圈X重写片段），
# Pen 原本用 script.hub 链接转成 Loon 插件导入，但 script.hub
# 转换结果不带图标，所以做了这个原生 Loon 版，只多了 #!icon，
# 规则和脚本与原版一一对应，没有改动去广告逻辑：
#
#   1. 原片段 2 条 host reject（广告域名直连拦截）
#      -> 转成 [Rule] 里的 DOMAIN, ..., REJECT
#   2. 原片段 5 条 script 规则 -> 转成 [Script] 的
#      http-request / http-response，脚本本体仍指向作者 GitHub
#      上的 Txvideoad.js 远程文件，作者更新脚本这边自动跟随
#   3. 脚本处理的是二进制协议数据（读 bodyBytes），所以除
#      rdelivery 那条（脚本里读的是 JSON 文本）外，其余脚本行
#      都带 binary-body-mode=true，这是 Loon 传二进制 body 的
#      必要参数，script.hub 转换不一定会加
#   4. MITM 域名与原片段 hostname 行完全一致（4 个）
#
# 注意：
#   - 这是本地文件版，不是订阅：作者日后若改了片段的规则部分
#     （新增/修改接口），这份不会自动跟，需要喊我重做一版；
#     脚本逻辑的更新走远程 JS，不受影响
#   - 使用条件：Loon 开启重写 + MITM 并信任 CA 证书；
#     [Rule] 部分需规则分流模式
#   - 安装：先在 Loon 里删掉之前 script.hub 导入的那个同名
#     插件（不删图标刷不出来），再用本文件链接重新添加；
#     装好后彻底划掉腾讯视频重开一次（广告配置有缓存）
# ============================================================

[Rule]

# 广告域名直连拦截（原片段的 host reject 两条）
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]

# i.video.qq.com：请求体清洗（播放贴片/前贴广告点位）
http-request ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=腾讯视频-请求清洗

# i.video.qq.com：响应体清洗（开屏、信息流、个人中心广告等）
http-response ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=腾讯视频-响应清洗

# iacc.qq.com：响应体清洗（暂停广告、贴片广告，JCE 二进制）
http-response ^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=腾讯视频-iacc清洗

# config.ab.qq.com：底部栏配置（去掉「短剧」「好物」等多余入口）
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=腾讯视频-底部栏配置

# rdelivery.qq.com：SDK 配置（tab_gray 文本修正，读 JSON 文本不走二进制）
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, tag=腾讯视频-SDK配置

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
