#!name=中国移动去广告
#!desc=去除中国移动 App 肉眼可见的广告：启动页、首页下拉与悬浮广告、弹窗、办理页横幅等。原脚本为 Yuheng 的《广告移不动》（NoAds.js），本文件是给 Loon 用的转换版，并补上了中国移动官方图标。
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/5d/43/bc/5d43bcf0-e99a-3d93-ad31-6303b1c7bc5e/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/512x512bb.jpg
#!author=Yuheng
#!homepage=https://github.com/Yuheng0101/X
#!date=2026-11-15
#!category=Yuheng

# ============================================================
# 中国移动去广告（Loon 插件）— 带图标版
# ------------------------------------------------------------
# 来源：Yuheng0101/X 仓库的 Scripts/ChinaMobile/NoAds.js，
# 重写规则就写在脚本开头的注释块里（圈X格式）。Pen 原本用
# script.hub 链接转成 Loon 插件导入，但转换结果不带图标，
# 所以做了这个原生 Loon 版，只多了 #!icon，规则和脚本与
# 原版一一对应，没有改动去广告逻辑：
#
#   1. 原规则 6 条 script-response-body -> 转成 [Script]
#      的 http-response，脚本本体仍指向作者 GitHub 上的
#      NoAds.js 远程文件，作者更新脚本这边自动跟随
#   2. 原规则 1 条 reject-200（弹窗接口）-> 转成 [Rewrite]
#      的 reject-200，处理的是 JSON 接口，不涉及二进制，
#      脚本行不加 binary-body-mode
#   3. MITM 域名与原脚本 hostname 行完全一致（2 个）
#
# 作者原说明：App 内大部分活动是 web-view 嵌 H5、链接不定，
# 本脚本不对内部活动做广告去除，只处理肉眼可见的广告位。
#
# 注意：
#   - 这是本地文件版，不是订阅：作者日后若在脚本注释块里
#     改了规则部分，这份不会自动跟，需要喊我重做一版；
#     脚本逻辑的更新走远程 JS，不受影响
#   - 使用条件：Loon 开启重写 + MITM 并信任 CA 证书
#   - 安装：先在 Loon 里删掉之前 script.hub 导入的那个同名
#     插件（不删图标刷不出来），再用本文件链接重新添加；
#     装好后彻底划掉中国移动 App 重开一次（广告配置有缓存）
# ============================================================

[Rewrite]

# 弹窗接口：直接返回空响应（原规则 reject-200）
^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/popupWindow\/getDetail reject-200

[Script]

# 启动页
http-response ^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit$ script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/ChinaMobile/NoAds.js, requires-body=true, tag=中国移动-启动页

# 首页下拉
http-response ^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/newTopPullSecond\/getNewTopPullList script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/ChinaMobile/NoAds.js, requires-body=true, tag=中国移动-首页下拉

# 首页悬浮广告
http-response ^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/emotionMarket\/getEmotionMarketNew script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/ChinaMobile/NoAds.js, requires-body=true, tag=中国移动-首页悬浮

# 首页顶部区域
http-response ^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/homeArea\/getTopAreaList script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/ChinaMobile/NoAds.js, requires-body=true, tag=中国移动-首页顶部

# 办理页横幅
http-response ^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/navigation\/getNavigationNewInfo script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/ChinaMobile/NoAds.js, requires-body=true, tag=中国移动-办理横幅

# 我的页面弹窗
http-response ^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/friendShake\/getShakeList script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/ChinaMobile/NoAds.js, requires-body=true, tag=中国移动-我的弹窗

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn
